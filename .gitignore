# --- working notes (never published) ---
notes/

# --- env / secrets ---
.env
.env.*
!.env.example

# --- editors / OS ---
.idea/
*.iml
.vscode/
.DS_Store

# Java/Gradle ignores live in backend/.gitignore, Node ignores in frontend/.gitignore
# so the Gradle wrapper jar (which MUST be committed for `./gradlew` to work on a
# fresh clone) isn't caught by a blanket *.jar rule here.
